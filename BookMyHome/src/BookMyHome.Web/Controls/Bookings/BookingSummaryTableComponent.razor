<RadzenDataGrid AllowColumnResize="true" Data="@Bookings" TItem="BookingSummaryResponse">
    <Columns>
        <RadzenDataGridColumn Property="@nameof(BookingSummaryResponse.BookingNumber)" Title="Booking nummer" Width="160px" Frozen="true" />
        <RadzenDataGridColumn Property="@nameof(BookingSummaryResponse.ListingName)" Title="Titel" Width="300px" Frozen="false" />
        <RadzenDataGridColumn Property="@nameof(BookingSummaryResponse.ListingType)" Title="Bolig type" Frozen="false" Width="100px" />
        <RadzenDataGridColumn Property="@nameof(BookingSummaryResponse.City)" Title="By" Frozen="false" Width="150px" />
        <RadzenDataGridColumn Property="@nameof(BookingSummaryResponse.Country)" Title="Land" Frozen="false" Width="150px" />
        <RadzenDataGridColumn Property="@nameof(BookingSummaryResponse.StartDate)" Title="Start dato" Frozen="false" Width="150px" />
        <RadzenDataGridColumn Property="@nameof(BookingSummaryResponse.EndDate)" Title="Slut dato" Frozen="false" Width="150px" />
        <RadzenDataGridColumn Property="@nameof(BookingSummaryResponse.Price)" Title="Pris" Frozen="false" Width="150px" />
        <RadzenDataGridColumn Property="@nameof(BookingSummaryResponse.BookingStatus)" Title="Status" Frozen="false" Width="100px" />

        <RadzenDataGridColumn Titem="BookingSummaryResponse"
                              Title="Handling"
                              Sortable="false"
                              Filterable="false">
            <Template Context="booking">
                @if (booking.BookingStatus == "Booked")
                {
                    <RadzenButton Text="Afbestil"
                                  ButtonType="ButtonType.Button"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Size="ButtonSize.Small"
                                  Click="@(_ => HandleCancel(booking))" />
                }
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<BookingSummaryResponse> Bookings { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<BookingSummaryResponse> CancelCallback { get; set; }


    private void HandleCancel(BookingSummaryResponse booking)
    {
        CancelCallback.InvokeAsync(booking);
    }

}
