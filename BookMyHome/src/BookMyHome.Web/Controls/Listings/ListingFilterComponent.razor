
<RadzenStack Gap="0.5rem">
    <RadzenLabel Text="Sorter efter lokation" Component="LocationSearch" />
    <RadzenTextBox Style="width: 100%; max-width: 400px;" Name="LocationSearch" Change="@(_ => ApplyFilters())" @bind-Value="sortLocation" Immediate="true" />
</RadzenStack>
<RadzenStack Gap="0.5rem">
    <RadzenLabel Text="Sorter efter pris" Component="DropDownSortPrice" />
    <RadzenDropDown @bind-Value=@sortPrice
                    Data=@sortPriceTypes
                    Style="width: 100%; max-width: 400px;"
                    Name="DropDownSortPrice"
                    Change="@(_ => ApplyFilters())" />
</RadzenStack>
<RadzenStack Gap="0.5rem">
    <RadzenLabel Text="Sorter efter facilities" Component="DropDownMultipleFacilities" />
    <RadzenDropDown @bind-Value=@sortFacilities
                    Data=@Facilities
                    TextProperty="@nameof(FacilityResponse.Name)"
                    ValueProperty="@nameof(FacilityResponse.Name)"
                    Name="DropDownMultipleFacilties"
                    Multiple=true
                    AllowClear=true
                    Placeholder="Select facilities"
                    Style="width: 100%; max-width: 400px;"
                    Change="@(_ => ApplyFilters())" />
</RadzenStack>



@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ListingResponse> ListingsList { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<FacilityResponse> Facilities { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<IReadOnlyList<ListingResponse>> FilteredListChangedCallback { get; set; }

    private string sortPrice = string.Empty;
    private string sortLocation = string.Empty;
    private List<string>? sortFacilities;
    private List<string> sortPriceTypes = new() { "", "Højeste til laveste", "Laveste til højeste" };

    private IReadOnlyList<ListingResponse>? previousListingsList;


    protected override async Task OnParametersSetAsync()
    {
        if (ReferenceEquals(previousListingsList, ListingsList) == true)
            return;

        previousListingsList = ListingsList;

        await ApplyFilters();
    }

    private async Task ApplyFilters()
    {
        IEnumerable<ListingResponse> query = ListingsList;

        // Lokation
        if (string.IsNullOrWhiteSpace(sortLocation) == false)
        {
            query = query
            .Where(l =>
                l.Street.Contains(sortLocation, StringComparison.CurrentCultureIgnoreCase) ||
                l.PostalCode.Contains(sortLocation, StringComparison.CurrentCultureIgnoreCase) ||
                l.City.Contains(sortLocation, StringComparison.CurrentCultureIgnoreCase)
            );
        }

        // Pris
        if (string.IsNullOrWhiteSpace(sortPrice) == false)
        {
            if (sortPriceTypes.IndexOf(sortPrice) == 1)
            {
                query = query.OrderByDescending(l => l.DailyPrice);
            }
            else if (sortPriceTypes.IndexOf(sortPrice) == 2)
            {
                query = query.OrderBy(l => l.DailyPrice);
            }
        }

        if (sortFacilities == null)
            sortFacilities = [];

        // Facility
        if (sortFacilities.Count != 0 && ListingsList.Count != 0)
        {
            foreach (var facility in sortFacilities)
            {
                query = query.Where(l => l.Facilities.Contains(facility));
            }

        }

        await FilteredListChangedCallback.InvokeAsync(query.ToList());

    }
}