<RadzenCard class="rz-my-12 rz-mx-auto rz-p-4 rz-p-md-12" style="max-width: 600px;">
    <RadzenTemplateForm TItem="ListingInputModel" Data=@Model Submit=@HandleSubmit>
        <RadzenStack Gap="1rem">
            <article>
                <RadzenText TextStyle="TextStyle.DisplayH4">@FormTitle</RadzenText>
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" Gap="1rem" class="rz-p-4">
                    @if (Model.ImageFile != null)
                    {
                        <RadzenImage Path="@imagePreview"
                                     AlternateText="Forhåndsvisning af valgt billede"
                                     Style="max-width: 500px; height: auto;" />
                    }
                    else if (Model.ImageUrl != null)
                    {
                        <RadzenImage Path="@Model.ImageUrl"
                                     AlternateText="Listing image"
                                     Style="max-width: 500px; height: auto;" />
                    }
                </RadzenStack>
                <article>
                    <InputFile OnChange="OnImageSelected" accept="image/png,image/jpeg" />
                </article>
                <br />
                <RadzenRow AlignItems="AlignItems.Start" JustifyContent="JustifyContent.Center" RowGap="0.25rem">
                    <RadzenColumn Size="12" SizeMD="4" class="rz-text-align-start rz-text-align-md-end">
                        <RadzenLabel Text="Listing Titel" Component="ListingName" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="8">
                        <RadzenTextBox Name="ListingName" @bind-Value=@Model.ListingName Style="display: block; width: 100%;" />
                        <RadzenRequiredValidator Component="ListingName" Text="Listing title is required." Style="position: absolute" />
                    </RadzenColumn>
                </RadzenRow>
                <br />
                <RadzenRow AlignItems="AlignItems.Start" JustifyContent="JustifyContent.Center" RowGap="0.25rem">
                    <RadzenColumn Size="12" SizeMD="4" class="rz-text-align-start rz-text-align-md-end">
                        <RadzenLabel Text="Daglig pris" Component="DailyPrice" />

                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="8">
                        <RadzenNumeric Name="DailyPrice" @bind-Value=@Model.DailyPrice Style="display: block; width: 100%;" />
                        <RadzenRequiredValidator Component="DailyPrice" Text="Daily price is required." Style="position: absolute" />
                        <RadzenNumericRangeValidator Component="DailyPrice" Min="0" Text="Daily price is not valid" Style="position: absolute" />
                    </RadzenColumn>
                </RadzenRow>
                <br />
                <RadzenRow AlignItems="AlignItems.Start" JustifyContent="JustifyContent.Center" RowGap="0.25rem">
                    <RadzenColumn Size="12" SizeMD="4" class="rz-text-align-start rz-text-align-md-end">
                        <RadzenLabel Text="Hus regler" Component="HouseRules" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="8">
                        <RadzenTextBox Name="HouseRules" @bind-Value=@Model.HouseRules Style="display: block; width: 100%;" />
                        <RadzenRequiredValidator Component="HouseRules" Text="House rules is required." Style="position: absolute" />
                    </RadzenColumn>
                </RadzenRow>
            </article>
            <article>

                <RadzenRow AlignItems="AlignItems.Start" JustifyContent="JustifyContent.Center" RowGap="0.25rem">
                    <RadzenColumn Size="12" SizeMD="4" class="rz-text-align-start rz-text-align-md-end">
                        <RadzenLabel Text="Type" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="8">
                        <RadzenRadioButtonList @bind-Value="Model.AccomodationType" TValue="string">
                            <Items>
                                @foreach (var type in AccomodationsTypes)
                                {
                                    <RadzenRadioButtonListItem Text="@type.Type" Value="@type.Type" />
                                }
                            </Items>
                        </RadzenRadioButtonList>
                    </RadzenColumn>
                </RadzenRow>
                <br />
                <RadzenRow AlignItems="AlignItems.Start" JustifyContent="JustifyContent.Center" RowGap="0.25rem">
                    <RadzenColumn Size="12" SizeMD="4" class="rz-text-align-start rz-text-align-md-end">
                        <RadzenLabel Text="Status" Component="ListingStatus" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="8">
                        <RadzenSwitch @bind-Value=@Model.Status Component="ListingStatus" />
                    </RadzenColumn>
                </RadzenRow>

                <br />
                <RadzenRow AlignItems="AlignItems.Start" class="rz-mt-4">
                    <RadzenColumn Size="12" Offset="0" SizeMD="8" OffsetMD="4">
                        <RadzenButton ButtonType="ButtonType.Submit" Text="@SubmitText" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" Offset="0" SizeMD="8" OffsetMD="0">
                        <RadzenButton ButtonType="ButtonType.Button" Text="Cancel" ButtonStyle="ButtonStyle.Secondary" Click="Cancel" />
                    </RadzenColumn>
                </RadzenRow>
            </article>
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenCard>

@inject NavigationManager NavigationManager

@code {
    [Parameter, EditorRequired]
    public ListingInputModel Model { get; set; }

    [Parameter, EditorRequired]
    public string FormTitle { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<ListingInputModel> SubmitCallback { get; set; }

    [Parameter, EditorRequired]
    public string SubmitText { get; set; }

    [Parameter, EditorRequired]
    public string CancelNavigationPath { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<AccomodationTypeResponse> AccomodationsTypes { get; set; }

    private string? imagePreview;

    private void HandleSubmit()
    {
        SubmitCallback.InvokeAsync(Model);
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo(CancelNavigationPath);
    }

    private async Task OnImageSelected(InputFileChangeEventArgs args)
    {
        Model.ImageFile = args.File;

        using var stream = args.File.OpenReadStream(5 * 1024 * 1024);
        using var memory = new MemoryStream();

        await stream.CopyToAsync(memory);

        imagePreview = $"data:{args.File.ContentType};base64,{Convert.ToBase64String(memory.ToArray())}";
    }
}
