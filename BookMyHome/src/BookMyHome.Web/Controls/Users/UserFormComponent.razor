@inject NavigationManager navigationManager


<RadzenCard class="rz-my-12 rz-mx-auto rz-p-4 rz-p-md-12" style="max-width: 600px;">
    <RadzenTemplateForm TItem="UserInputModel" Data=@Model Submit=@HandleSubmit>
        <RadzenStack Gap="1rem">
            <article>
                <h4>Generelt</h4>
                <RadzenRow AlignItems="AlignItems.Center" RowGap="0.25rem">
                    <RadzenColumn Size="12" SizeMD="4" class="rz-text-align-start rz-text-align-md-end">
                        <RadzenLabel Text="Fornavn" Component="FirstName" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="8">
                        <RadzenTextBox Name="FirstName" @bind-Value=@Model.FirstName Style="display: block; width: 100%;" />
                        <RadzenRequiredValidator Component="FirstName" Text="First name is required." Style="position: absolute" />
                    </RadzenColumn>
                </RadzenRow>
                <br />
                <RadzenRow AlignItems="AlignItems.Center" RowGap="0.25rem">
                    <RadzenColumn Size="12" SizeMD="4" class="rz-text-align-start rz-text-align-md-end">
                        <RadzenLabel Text="Efternavn" Component="LastName" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="8">
                        <RadzenTextBox Name="LastName" @bind-Value=@Model.LastName Style="display: block; width: 100%;" />
                        <RadzenRequiredValidator Component="LastName" Text="Last name is required." Style="position: absolute" />
                    </RadzenColumn>
                </RadzenRow>
                <br />
                <RadzenRow AlignItems="AlignItems.Center" RowGap="0.25rem">
                    <RadzenColumn Size="12" SizeMD="4" class="rz-text-align-start rz-text-align-md-end">
                        <RadzenLabel Text="Fødselsdato" Component="Birthdate" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="8">
                        <RadzenDatePicker Name="Birthdate" @bind-Value="@Model.Birthdate" DateFormat="dd/MM/yyyy" Style="display: block; width: 100%" />
                    </RadzenColumn>
                </RadzenRow>
                <br />
                @if (AccessRoles != null)
                {   
                    <RadzenRow AlignItems="AlignItems.Center" RowGap="0.25rem">
                        <RadzenColumn Size="12" SizeMD="4" class="rz-text-align-start rz-text-align-md-end">
                            <RadzenLabel Text="Indtast kodeord" Component="Password" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="8">
                            <RadzenPassword Name="Password" @bind-Value=@Model.Password Style="display: block; width: 100%;" />
                            <RadzenRequiredValidator Component="Password" Text="Password is required." Style="position: absolute" />
                        </RadzenColumn>
                    </RadzenRow>
                    <br />
                    <RadzenRow AlignItems="AlignItems.Center" RowGap="0.25rem">
                        <RadzenColumn Size="12" SizeMD="4" class="rz-text-align-start rz-text-align-md-end">
                            <RadzenLabel Text="Gentag kodeord" Component="RepeatPassword" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="8">
                            <RadzenPassword Name="RepeatPassword" @bind-Value=@Model.RepeatPassword style="display: block; width: 100%;" />
                            <RadzenCompareValidator Value=@Model.Password Component="RepeatPassword" Text="Passwords should be the same" Style="position: absolute" />
                        </RadzenColumn>
                    </RadzenRow>
                }
                else
                {
                    <RadzenRow AlignItems="AlignItems.Center" RowGap="0.25rem">
                        <RadzenColumn Size="12" SizeMD="4" class="rz-text-align-start rz-text-align-md-end">
                            <RadzenLabel Text="Brugernavn" Component="Username" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="8">
                            <RadzenTextBox Name="Username" @bind-Value=@Model.Username Style="display: block; width: 100%;" ReadOnly="true" />
                        </RadzenColumn>
                    </RadzenRow>
                }
            </article>
            <article>
                <h4>Kontakt oplysninger</h4>
                <RadzenRow AlignItems="AlignItems.Center" RowGap="0.25rem">
                    <RadzenColumn Size="12" SizeMD="4" class="rz-text-align-start rz-text-align-md-end">
                        <RadzenLabel Text="Email" Component="Email" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="8">
                        <RadzenTextBox Name="Email" @bind-Value=@Model.Email Style="display: block; width: 100%;" />
                        <RadzenRequiredValidator Component="Email" Text="Email is required." Style="position: absolute" />
                        <RadzenEmailValidator Component="Email" Text="Provide a valid email address." Style="position: absolute" />
                    </RadzenColumn>
                </RadzenRow>
                <br />
                <RadzenRow AlignItems="AlignItems.Center" RowGap="0.25rem">
                    <RadzenColumn Size="12" SizeMD="4" class="rz-text-align-start rz-text-align-md-end">
                        <RadzenLabel Text="Telefon nr." Component="PhoneNumber" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="8">
                        <RadzenTextBox Name="PhoneNumber" @bind-Value=@Model.PhoneNumber Style="display: block; width: 100%;" />
                        <RadzenRequiredValidator Component="PhoneNumber" Text="Phone number is required." Style="position: absolute" />
                        <RadzenNumericRangeValidator Component="PhoneNumber" Min="10000000" Max="99999999" Text="Phone number is not valid" Style="position: absolute" />
                    </RadzenColumn>
                </RadzenRow>
            </article>
            <article>
                <h4>Addresse oplysninger</h4>
                <RadzenRow AlignItems="AlignItems.Center" RowGap="0.25rem">
                    <RadzenColumn Size="12" SizeMD="4" class="rz-text-align-start rz-text-align-md-end">
                        <RadzenLabel Text="Addresse" Component="Street" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="8">
                        <RadzenTextBox Name="Street" @bind-Value=@Model.Street Style="display: block; width: 100%;" />
                        <RadzenRequiredValidator Component="Street" Text="Street is required." Style="position: absolute" />
                    </RadzenColumn>
                </RadzenRow>
                <br />
                <RadzenRow AlignItems="AlignItems.Center" RowGap="0.25rem">
                    <RadzenColumn Size="12" SizeMD="4" class="rz-text-align-start rz-text-align-md-end">
                        <RadzenLabel Text="Postnr." Component="PostalCode" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="8">
                        <RadzenTextBox Name="PostalCode" @bind-Value=@Model.PostalCode Style="display: block; width: 100%;" />
                        <RadzenRequiredValidator Component="PostalCode" Text="Postal code is required." Style="position: absolute" />
                        <RadzenNumericRangeValidator Component="PostalCode" Min="1000" Max="9999" Text="Postal code is not valid" Style="position: absolute" />
                    </RadzenColumn>
                </RadzenRow>
                <br />
                <RadzenRow AlignItems="AlignItems.Center" RowGap="0.25rem">
                    <RadzenColumn Size="12" SizeMD="4" class="rz-text-align-start rz-text-align-md-end">
                        <RadzenLabel Text="By" Component="City" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="8">
                        <RadzenTextBox Name="City" @bind-Value=@Model.City Style="display: block; width: 100%;" />
                        <RadzenRequiredValidator Component="City" Text="City is required." Style="position: absolute" />
                    </RadzenColumn>
                </RadzenRow>
            </article>
            @if (AccessRoles != null)
            {
                <article>
                    <h4>Adgangs rolle</h4>
                    <RadzenRow AlignItems="AlignItems.Center" RowGap="0.25rem">
                        <RadzenColumn Size="12" SizeMD="8">
                            <RadzenRadioButtonList @bind-Value="Model.AccessRole" TValue="string">
                                <Items>
                                    @foreach (var type in AccessRoles)
                                    {
                                        <RadzenRadioButtonListItem Text="@type.Role" Value="@type.Role" />
                                    }
                                </Items>
                            </RadzenRadioButtonList>
                        </RadzenColumn>
                    </RadzenRow>
                </article>
            }
            <RadzenRow AlignItems="AlignItems.Center" class="rz-mt-4">
                <RadzenColumn Size="12" Offset="0" SizeMD="8" OffsetMD="4">
                    <RadzenButton ButtonType="ButtonType.Submit" Text="@SubmitText" ButtonStyle="ButtonStyle.Primary" />
                </RadzenColumn>
                <RadzenColumn Size="12" Offset="0" SizeMD="8" OffsetMD="0">
                    <RadzenButton ButtonType="ButtonType.Button" Text="Cancel" ButtonStyle="ButtonStyle.Secondary" Click="Cancel" />
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenCard>

@code {
    [Parameter, EditorRequired]
    public UserInputModel Model { get; set; }

    [Parameter]
    public IReadOnlyList<AccessRoleReponse>? AccessRoles { get; set; } = null;

    [Parameter, EditorRequired]
    public EventCallback<UserInputModel> SubmitCallback { get; set; }

    [Parameter, EditorRequired]
    public string SubmitText { get; set; }

    [Parameter, EditorRequired]
    public string CancelPath { get; set; }

    private void HandleSubmit()
    {
        SubmitCallback.InvokeAsync(Model);
    }

    private void Cancel()
    {
        navigationManager.NavigateTo(CancelPath);
    }
}
