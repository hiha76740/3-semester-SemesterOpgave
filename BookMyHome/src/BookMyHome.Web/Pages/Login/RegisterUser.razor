@page "/register"
@using BookMyHome.Web.Models
@inject IAuthService authService
@inject IUserService userService
@inject NavigationManager navigationManager
@inject DialogService Dialog


<UserFormComponent Model="model"
                   SubmitCallback="Create"
                   SubmitText="Registre"
                   AccessRoles="AccessRoles"
                   CancelPath="/login" />




@code {
    private UserInputModel model = new();
    private IReadOnlyList<AccessRoleReponse> AccessRoles = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            AccessRoles = await userService.GetAllAccessRoles();
        }
        catch (Exception ex)
        {
            await Dialog.Alert(ex.Message, "Initial error");
        }

    }

    private async Task Create(UserInputModel model)
    {
        try
        {
            var request = new RegisterUserRequest(
            model.FirstName,
            model.LastName,
            model.Birthdate,
            model.Street,
            model.PostalCode,
            model.City,
            model.PhoneNumber,
            model.Email,
            model.Password,
            model.AccessRole
        );

            var responseCode = await authService.Register(request);

            if (responseCode == 200)
            {
                await Dialog.Alert("User created successfully", "Information");
                navigationManager.NavigateTo("/login");
            }
            
        }
        catch (Exception ex)
        {
            await Dialog.Alert(ex.Message, "Create error");
        }

        
    }
}
