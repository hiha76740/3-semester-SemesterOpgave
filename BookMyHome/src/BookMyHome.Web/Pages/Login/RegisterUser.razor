@page "/register"
@using BookMyHome.Web.Models
@inject IAuthService authService
@inject IUserService userService
@inject NavigationManager navigationManager


@if (error != null)
{

}
else
{
    <UserFormComponent model="model" 
        SubmitCallback="Create" 
        SubmitText="Registre" 
        AccessRoles="AccessRoles"
        CancelPath="/login"/>
}



@code {
    private UserInputModel model = new();
    private IReadOnlyList<AccessRoleReponse> AccessRoles = [];
    private string? error = null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            AccessRoles = await userService.GetAllAccessRoles();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }

    }

    private async Task Create(UserInputModel model)
    {
        try
        {
            var request = new RegisterUserRequest(
            model.FirstName,
            model.LastName,
            model.Birthdate,
            model.Street,
            model.PostalCode,
            model.City,
            model.PhoneNumber,
            model.Email,
            model.Password,
            model.AccessRole
        );

            var responseCode = await authService.Register(request);

            if (responseCode == 200)
                navigationManager.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }

        
    }
}
