@page "/register"
@inject IAuthService authService
@inject IUserService userService
@inject NavigationManager navigationManager


@if(error != null)
{
    
}
else
{
    <UserFormComponent SubmitCallback="@Create"
                       AccessRoles="AccessRoles"
                       SubmitText="Create" />
}



@code {
    private IReadOnlyList<AccessRoleReponse> AccessRoles = [];
    private string? error = null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            AccessRoles = await userService.GetAllAccessRoles();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }

    }

    private async Task Create(RegisterUserRequest request)
    {
        try
        {
            var responseCode = await authService.Register(request);

            if (responseCode == 200)
                navigationManager.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }

        
    }
}
