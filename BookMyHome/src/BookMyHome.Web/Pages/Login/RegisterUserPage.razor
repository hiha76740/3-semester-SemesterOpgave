@page "/register"
@inject IAuthService authService
@inject IUserService userService
@inject NavigationManager navigationManager
@using BookMyHome.ContractsLib.Requests.Users
@using BookMyHome.ContractsLib.Responses.Users
@using BookMyHome.Web.Controls.Users
@using BookMyHome.Web.Services

<UserFormComponent SubmitCallback="@Create"
                   AccessRoles="AccessRoles"
                   SubmitText="Create" />

@code {
    private IReadOnlyList<AccessRoleReponse> AccessRoles = [];


    protected override async Task OnInitializedAsync()
    {
        AccessRoles = await userService.GetAllAccessRoles();
    }

    private async Task Create(RegisterUserRequest request)
    {
        var responseCode = await authService.Register(request);

        if (responseCode == 200)
            navigationManager.NavigateTo("/login");
    }
}
