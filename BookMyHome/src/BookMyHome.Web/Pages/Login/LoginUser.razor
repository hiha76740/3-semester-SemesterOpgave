@page "/login"
@using BookMyHome.Web.States
@inject IAuthService Service
@inject NavigationManager NavigationManager
@inject UserState userState

@if (error != null)
{
    <p>@error</p>
}
else
{
    <RadzenCard class="rz-my-12 rz-mx-auto rz-p-4 rz-p-md-12" style="max-width: 600px;">
        <RadzenLogin AllowRegister="true"
                     AllowResetPassword="false"
                     Login="@(args => Login(args))"
                     Register="(args => Register())" />
    </RadzenCard>
}



@code {

    private string? error = null;

    private async Task Login(LoginArgs args)
    {
        try
        {
            var reponse = await Service.Login(args.Username!, args.Password!);

            if (reponse == 200)
            {
                var authUser = await Service.GetAuthUserAsync();

                userState.UserId = authUser.Id;
                userState.Firstname = authUser.Firstname;
                userState.Lastname = authUser.Lastname;
                userState.Username = authUser.Username;
                userState.Role = authUser.Role;

                NavigationManager.NavigateTo("/");
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }

    }

    async Task Register()
    {
        NavigationManager.NavigateTo("/register");
    }
}
