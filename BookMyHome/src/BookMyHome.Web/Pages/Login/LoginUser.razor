@page "/login"

@inject IAuthService Service
@inject NavigationManager NavigationManager
@inject UserState UserState
@inject DialogService Dialog


<RadzenCard class="rz-my-12 rz-mx-auto rz-p-4 rz-p-md-12" style="max-width: 600px;">
    <RadzenLogin AllowRegister="true"
                 AllowResetPassword="false"
                 Login="@(args => Login(args))"
                 Register="(args => Register())" />
</RadzenCard>

@code {

    private string? error = null;

    private async Task Login(LoginArgs args)
    {
        try
        {
            var reponse = await Service.Login(args.Username!, args.Password!);

            if (reponse == 200)
            {
                var authUser = await Service.GetAuthUserAsync();

                UserState.SetUser(
                    authUser.Id,
                    authUser.Firstname,
                    authUser.Lastname,
                    authUser.Username,
                    authUser.Role
                );

                NavigationManager.NavigateTo("/");
            }
        }
        catch (Exception ex)
        {
            await Dialog.Alert(ex.Message, "Login error");
        }

    }

    async Task Register()
    {
        NavigationManager.NavigateTo("/register");
    }
}
