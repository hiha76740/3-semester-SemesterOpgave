@page "/login"


@inject IAuthService Service
@inject NavigationManager NavigationManager
@inject DialogService Dialog
@inject CustomAuthenticationStateProvider AuthStateProvider


<RadzenCard class="rz-my-12 rz-mx-auto rz-p-4 rz-p-md-12" style="max-width: 600px;">
    <RadzenLogin AllowRegister="true"
                 AllowResetPassword="false"
                 Login="@(args => Authenticate(args))"
                 Register="(args => Register())" />
</RadzenCard>

@code {

    private async Task Authenticate(LoginArgs args)
    {
        try
        {
            var reponse = await Service.Login(args.Username!, args.Password!);

            if (reponse == 200)
            {
                await AuthStateProvider.RefreshAuthenticationState();

                NavigationManager.NavigateTo("/");
            }
            else
            {
                await Dialog.Alert("User or password was incorrect", "Login error");
            }
        }
        catch (Exception ex)
        {
            await Dialog.Alert(ex.Message, "Login error");
        }

    }

    async Task Register()
    {
        NavigationManager.NavigateTo("/register");
    }
}
