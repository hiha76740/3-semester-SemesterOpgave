@page "/login"
@inject IUserService Service
@using BookMyHome.ContractsLib.Requests.Users
@using BookMyHome.Web.Services

<RadzenLogin AllowRegister="true"
             AllowResetPassword="false"
             Login="@(args => Login(args))"
             Register="@(args => Register())" />

@code {

    private async Task Login(LoginArgs args)
    {
        await Service.Login(args.Username!, args.Password!);
    }

    async Task Register()
    {
        var request = new RegisterUserRequest("Harry","Potter",new DateOnly(1987,07,30),"Legustervænget 7","7100","Vejle","95175312","HarryPotter@Hogwarts.test","Hedwig","Guest");

        var statusCode = await Service.Register(request);
    }
}
