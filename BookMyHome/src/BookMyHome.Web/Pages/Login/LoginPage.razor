@page "/login"
@inject IAuthService Service
@inject NavigationManager NavigationManager
@using BookMyHome.Web.Services


<RadzenCard class="rz-my-12 rz-mx-auto rz-p-4 rz-p-md-12" style="max-width: 600px;">
    <RadzenLogin AllowRegister="true"
                 AllowResetPassword="false"
                 Login="@(args => Login(args))"
                 Register="(args => Register())" />
</RadzenCard>

@code {

    private async Task Login(LoginArgs args)
    {
        var reponse = await Service.Login(args.Username!, args.Password!);

        if (reponse == 200)
        {
            NavigationManager.NavigateTo("/");
        }
    }

    async Task Register()
    {
        NavigationManager.NavigateTo("/register");
    }
}
