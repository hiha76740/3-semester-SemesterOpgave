@page "/user/bookings"
@using BookMyHome.ContractsLib.Responses.Bookings

@inject IBookingService Service
@inject UserState User
@inject DialogService DialogService

@if (Bookings != null)
{
    <RadzenDataGrid Data="@Bookings" TItem="BookingResponse">
        <Columns>
            <RadzenDataGridColumn Property="@nameof(BookingResponse.StartDate)" Title="Start dato" Frozen="true" Width="160px" />
            <RadzenDataGridColumn Property="@nameof(BookingResponse.EndDate)" Title="Slut dato" Frozen="true" Width="160px" />
            <RadzenDataGridColumn Property="@nameof(BookingResponse.Price)" Title="Pris" Frozen="true" Width="160px" />

            <RadzenDataGridColumn Titem="BookingResponse"
                                  Title="Handling"
                                  Sortable="false"
                                  Filterable="false">
                <Template Context="booking">
                    <RadzenButton Text="Afbestil"
                                  ButtonType="ButtonType.Button"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Size="ButtonSize.Small"
                                  Click="@(_ => Cancel(booking))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}



@code {
    private IReadOnlyList<BookingResponse>? Bookings;


    /*
    Listing navn
        Listing type
        By
        Land
        Start dato
        Slut dato
        Pris
     */

    protected override async Task OnInitializedAsync()
    {
        if (User.UserId != null)
        {
            Bookings = await Service.GetUserBookingsAsync();
        }

    }

    private async Task Cancel(BookingResponse booking)
    {
        var result = await DialogService.Confirm(
            $"Er du sikker på du vil afbestille {booking.Id}? ",
            "Afbestilling",
            new ConfirmOptions()
            {
                OkButtonText = "Ja, afbestil",
                CancelButtonText = "Nej",
                CloseDialogOnEsc = true
            });

        if (result == true)
        {
            await Service.CancelBookingAsync(booking.Id);
            Bookings = await Service.GetUserBookingsAsync();
        }
    }
}
