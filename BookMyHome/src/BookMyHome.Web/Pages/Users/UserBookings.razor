@page "/user/bookings"

@inject IBookingService Service
@inject UserState User
@inject DialogService DialogService

<BookingSummaryTableComponent 
    Bookings="Bookings" 
    CancelCallback="Cancel"/>


@code {
    private IReadOnlyList<BookingSummaryResponse>? Bookings;

    protected override async Task OnInitializedAsync()
    {
        if (User.UserId != null)
        {
            Bookings = await Service.GetUserBookingsAsync();
            Bookings = Bookings.OrderBy(b => b.StartDate).ToList();
        }

    }

    private async Task Cancel(BookingSummaryResponse booking)
    {
        var result = await DialogService.Confirm(
            $"Er du sikker på du vil afbestille {booking.ListingName}? ",
            "Afbestilling",
            new ConfirmOptions()
            {
                OkButtonText = "Ja, afbestil",
                CancelButtonText = "Nej",
                CloseDialogOnEsc = true
            });

        if (result == true)
        {
            await Service.CancelBookingAsync(booking.BookingId);
            Bookings = await Service.GetUserBookingsAsync();
        }
    }
}
