@page "/user/bookings"
@using BookMyHome.ContractsLib.Responses.Bookings

@inject IBookingService Service
@inject UserState User
@inject DialogService DialogService

@if (Bookings != null)
{
    <RadzenDataGrid Data="@Bookings" TItem="BookingSummaryResponse">
        <Columns>
            <RadzenDataGridColumn Property="@nameof(BookingSummaryResponse.ListingName)" Title="Titel" Width="160px" />
            <RadzenDataGridColumn Property="@nameof(BookingSummaryResponse.ListingType)" Title="Bolig type" Frozen="true" Width="160px" />
            <RadzenDataGridColumn Property="@nameof(BookingSummaryResponse.City)" Title="By" Frozen="true" Width="160px" />
            <RadzenDataGridColumn Property="@nameof(BookingSummaryResponse.Country)" Title="Land" Frozen="true" Width="160px" />
            <RadzenDataGridColumn Property="@nameof(BookingSummaryResponse.StartDate)" Title="Start dato" Frozen="true" Width="160px" />
            <RadzenDataGridColumn Property="@nameof(BookingSummaryResponse.EndDate)" Title="Slut dato" Frozen="true" Width="160px" />
            <RadzenDataGridColumn Property="@nameof(BookingSummaryResponse.Price)" Title="Pris" Frozen="true" Width="160px" />

            <RadzenDataGridColumn Titem="BookingSummaryResponse"
                                  Title="Handling"
                                  Sortable="false"
                                  Filterable="false">
                <Template Context="booking">
                    <RadzenButton Text="Afbestil"
                                  ButtonType="ButtonType.Button"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Size="ButtonSize.Small"
                                  Click="@(_ => Cancel(booking))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}



@code {
    private IReadOnlyList<BookingSummaryResponse>? Bookings;

    protected override async Task OnInitializedAsync()
    {
        if (User.UserId != null)
        {
            Bookings = await Service.GetUserBookingsAsync();
            Bookings = Bookings.OrderBy(b => b.StartDate).ToList();
        }

    }

    private async Task Cancel(BookingSummaryResponse booking)
    {
        var result = await DialogService.Confirm(
            $"Er du sikker på du vil afbestille {booking.ListingName}? ",
            "Afbestilling",
            new ConfirmOptions()
            {
                OkButtonText = "Ja, afbestil",
                CancelButtonText = "Nej",
                CloseDialogOnEsc = true
            });

        if (result == true)
        {
            await Service.CancelBookingAsync(booking.BookingId);
            Bookings = await Service.GetUserBookingsAsync();
        }
    }
}
