@page "/user/profile"
@attribute [Authorize]

@inject CustomAuthenticationStateProvider AuthStateProvider
@inject IUserService Service
@inject DialogService Dialog


@if (user == null)
{
    <RadzenText TextStyle="TextStyle.Body1" Text="Indlæser bruger..."></RadzenText>
}
else
{
    <UserFormComponent Model="model"
                       SubmitCallback="UpdateUser"
                       SubmitText="Gem"
                       CancelPath="/"></UserFormComponent>
}

@code {
    private UserInputModel model = new();
    private UserResponse? user = null;

    async protected override Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authUser = authState.User;

            if (authUser.Identity?.IsAuthenticated == true)
            {
                var guestIdText = authUser.FindFirst(ClaimTypes.NameIdentifier)?.Value;

                if (Guid.TryParse(guestIdText, out var userId) == true)
                {
                    user = await Service.GetUserById(userId);

                    model.Id = user.Id;
                    model.FirstName = user.Firstname;
                    model.LastName = user.Lastname;
                    model.Birthdate = user.Birthdate;
                    model.Street = user.Street;
                    model.PostalCode = user.PostalCode;
                    model.City = user.City;
                    model.PhoneNumber = user.PhoneNumber;
                    model.Email = user.Email;
                    model.Username = user.Username;
                }
                else
                {
                    await Dialog.Alert("User id er ikke valid","Initial error");
                }
            }
        }
        catch (Exception ex)
        {
            await Dialog.Alert(ex.Message, "Initial error");
        }


    }

    private void UpdateUser(UserInputModel model)
    {

    }
}
