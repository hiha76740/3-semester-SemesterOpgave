@page "/user/profile"
@inject UserState UserState
@inject IUserService Service

<h3>UserProfile</h3>

@if(error != null)
{
    <p>@error</p>
}
else if(UserState.UserId == null && user == null )
{
    <p>Du skal logge ind for at se din profil</p>
}
else if (user == null)
{
    <p>Indlæser bruger...</p>
}
else
{
    <UserFormComponent model="model" SubmitCallback="UpdateUser" SubmitText="Gem" CancelPath="/"></UserFormComponent>
}


@code {
    private UserInputModel model = new();
    private UserResponse? user = null;
    private string? error;

    async protected override Task OnInitializedAsync()
    {
        try
        {
            if (UserState.UserId != null)
            {
                user = await Service.GetUserById(UserState.UserId.Value);

                model.FirstName = user.Firstname;
                model.LastName = user.Lastname;
                model.Birthdate = user.Birthdate;
                model.Street = user.Street;
                model.PostalCode = user.PostalCode;
                model.City = user.City;
                model.PhoneNumber = user.PhoneNumber;
                model.Email = user.Email;
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }


    }

    private void UpdateUser(UserInputModel model)
    {
        
    }
}
