@page "/accomodations"
@using BookMyHome.Web.Controls.Accomodations
@inject IAccomodationService Service

@foreach (var accomodation in AccomodationsList)
{
    <AccomodationCard Accomodation="accomodation"/>
}

@code {
    public IReadOnlyList<AccomodationResponse> AccomodationsList { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        AccomodationsList = await Service.GetCurrentUserAccomodationsAsync();
    }
}
