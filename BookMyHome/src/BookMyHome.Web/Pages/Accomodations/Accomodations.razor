@page "/accomodations"

@inject IAccomodationService Service
@inject NavigationManager NavigationManager

<RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Start">
    <RadzenText TextStyle="TextStyle.DisplayH3">Mine Boliger</RadzenText>
    <RadzenText TextStyle="TextStyle.DisplayH5">Administrer dine boliger og deres listings</RadzenText>

</RadzenStack>
&ensp;
<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" Gap="0">
    <RadzenButton Variant="Variant.Filled" Size="ButtonSize.Large" Text="Opret" Click="Create"></RadzenButton>
</RadzenStack>

@foreach (var accomodation in AccomodationsList)
{
    <AccomodationCard Accomodation="accomodation" />
}

@code {
    public IReadOnlyList<AccomodationResponse> AccomodationsList { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        AccomodationsList = await Service.GetCurrentUserAccomodationsAsync();
    }

    private void Create()
    {
        NavigationManager.NavigateTo("/accomodation/create");
    }
}
