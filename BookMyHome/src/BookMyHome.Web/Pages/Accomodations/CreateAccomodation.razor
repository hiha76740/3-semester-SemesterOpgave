@page "/accomodation/create"

@inject IAccomodationService AccomodationService
@inject IFacilityService FacilityService
@inject DialogService Dialog
@inject NavigationManager NavigationManager

<AccomodationFormComponent Model="model"
                           SubmitCallback="Create"
                           Facilities="Facilities"
                           SubmitText="Opret"
                           CancelPath="/accomodations" />


@code {
    private AccomodationInputModel model = new();
    private IReadOnlyList<FacilityResponse> Facilities = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Facilities = await FacilityService.GetAllFacilitiesAsync();
        }
        catch (Exception ex)
        {
            await Dialog.Alert(ex.Message, "Intial error");
        }
    }

    private async Task Create(AccomodationInputModel model)
    {
        try
        {
            var request = new CreateAccomodationRequest(
            model.Title,
            model.Street,
            model.PostalCode,
            model.City,
            model.Country,
            model.Facilities
            );

            var responseCode = await AccomodationService.Create(request);

            if (responseCode == 200)
            {
                await Dialog.Alert("Accomodation created successfully", "Information");
                NavigationManager.NavigateTo("/accomodations");
            }

            
}
        catch (Exception ex)
        {
            await Dialog.Alert(ex.Message, "Create error");
        }
    }

}
