@page "/accomodation/{id:guid}/listings"

@inject IListingService ListingService
@inject NavigationManager NavigationManager

<RadzenText TextStyle="TextStyle.H4" Text="Accomodation listings" />
<RadzenButton Variant="Variant.Text" class="rz-text-secondary-color" Text="<- Back" Click="@Back" />
<RadzenButton ButtonStyle="ButtonStyle.Primary" Text="Opret" Click="CreateNavigation" />

@foreach (var listing in Listings)
{
    <ListingCardComponent Listing="listing"
                          ButtonNavigationPath=@($"/listing/{listing.ListingId}/edit")
                          NavigationButtonText="Rediger" />
}

@code {
    private IReadOnlyList<ListingResponse> Listings { get; set; } = [];

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Listings = await ListingService.GetAccomodationListings(Id);
    }

    private void CreateNavigation()
    {
        NavigationManager.NavigateTo($"/accomodation/{Id}/listing/create");
    }

    private void Back()
    {
        NavigationManager.NavigateTo($"/accomodations");
    }
}
