@page "/accomodation/{id:guid}/bookings"

@inject IBookingService Service
@inject DialogService Dialog
@inject NavigationManager NavigationManager

<RadzenText TextStyle="TextStyle.H4" Text="Accomodation bookings"/>
<RadzenButton Variant="Variant.Text" class="rz-text-secondary-color" Text="<- Back" Click="@Back" />
<BookingSummaryTableComponent Bookings="Bookings" CancelCallback="Cancel" />

@code {
    [Parameter]
    public Guid Id { get; set; }

    private IReadOnlyList<BookingSummaryResponse> Bookings = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Bookings = await Service.GetAccomodationBookingsAsync(Id);
        }
        catch (Exception ex)
        {
            await Dialog.Alert(ex.Message, "Initial error");
        }

    }

    private async Task Cancel(BookingSummaryResponse booking)
    {
        var result = await Dialog.Confirm(
            $"Er du sikker på du vil afbestille {booking.ListingName}? ",
            "Afbestilling",
            new ConfirmOptions()
            {
                OkButtonText = "Ja, afbestil",
                CancelButtonText = "Nej",
                CloseDialogOnEsc = true
            });

        if (result == true)
        {
            try
            {
                await Service.CancelBookingAsync(booking.BookingId);
                Bookings = await Service.GetAccomodationBookingsAsync(Id);
            }
            catch (Exception ex)
            {
                await Dialog.Alert(ex.Message, "Cancellation error");
            }

        }
    }

    private void Back()
    {
        NavigationManager.NavigateTo($"/accomodations");
    }
}
