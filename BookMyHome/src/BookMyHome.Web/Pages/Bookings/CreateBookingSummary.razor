@page "/booking/create"
@attribute [Authorize(Roles = ("Guest"))]


@inject IBookingService Service
@inject BookingState Booking
@inject ListingState Listing
@inject NavigationManager NavigationManager
@inject DialogService Dialog
@inject CustomAuthenticationStateProvider AuthStateProvider

<BookingSummaryComponent Model="Model"
                         SubmitCallback="Submit"
                         Booking="Booking"
                         UserFullName="UserFullName"
                         Listing="Listing"
                         CancelNavigationPath="/listings" />


@code {
    private BookingInputModel Model = new();
    private string UserFullName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var firstName = user.FindFirst(ClaimTypes.GivenName)?.Value;
            var lastName = user.FindFirst(ClaimTypes.Surname)?.Value;

            UserFullName = $"{firstName} {lastName}";

            var guestIdText = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (Guid.TryParse(guestIdText, out var userId) == true)
            {
                Model.GuestId = userId;
                Model.AccomodationId = Booking.AccomodationId;
                Model.ListingId = Listing.Id;
                Model.StartDate = Booking.StartDate;
                Model.EndDate = Booking.EndDate;
                Model.Price = Booking.TotalPrice;
            }
            else
            {
                await Dialog.Alert("User Id er ikke valid");
                return;
            }
        }

    }

    async private Task Submit(BookingInputModel model)
    {
        try
        {
            var request = new CreateBookingRequest(
                    model.GuestId,
                    model.AccomodationId,
                    model.ListingId,
                    model.StartDate,
                    model.EndDate,
                    model.Price);

            var statusCode = await Service.MakeBookingAsync(request);

            if (statusCode == 200)
            {
                await Dialog.Alert("Booking oprettet korrekt", "Booking oprettelse");

                Booking.Clear();
                Listing.Clear();
                NavigationManager.NavigateTo("/listings");

                    
            }
        }
        catch (Exception ex)
        {
            await Dialog.Alert(ex.Message);
        }

    }
}
