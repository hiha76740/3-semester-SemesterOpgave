@page "/booking/create"
@using BookMyHome.ContractsLib.Requests.Bookings

@inject IBookingService Service
@inject BookingState Booking
@inject UserState User
@inject ListingState Listing
@inject NavigationManager NavigationManager
@inject DialogService Dialog

@if (error != null)
{
    <p>@error</p>
}
else
{
    <RadzenCard class="rz-my-12 rz-mx-auto" Style="max-width: 420px">
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" Gap="1rem" class="rz-p-4">
            <RadzenStack Gap="0">
                <RadzenText TextStyle="TextStyle.Overline" class="rz-display-flex rz-mt-2 rz-my-0">Fulde navn</RadzenText>
                <RadzenText TextStyle="TextStyle.Body1"><b>@(User.Firstname + " " + User.Lastname)</b></RadzenText>
                <RadzenText TextStyle="TextStyle.Overline" class="rz-display-flex rz-mt-4 rz-mb-0">Periode</RadzenText>
                <RadzenText TextStyle="TextStyle.Body1"><b>@($"{Booking.StartDate} - {Booking.EndDate}")</b></RadzenText>
            </RadzenStack>
        </RadzenStack>
        <RadzenCard class="rz-background-color-primary-light rz-shadow-0 rz-border-radius-0 rz-p-8" style="margin: 1rem calc(-1 * var(--rz-card-padding));">
            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.P" class="rz-color-on-primary-light"><strong>@Listing.Name</strong></RadzenText>
            <RadzenRow RowGap="0">
                <RadzenColumn SizeSM="4">
                    <RadzenText TextStyle="TextStyle.Overline" class="rz-color-on-primary-light rz-display-flex rz-mt-4 rz-mb-0">Type</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body1" class="rz-color-on-primary-light"><b>@Listing.Type</b></RadzenText>
                    <RadzenText TextStyle="TextStyle.Overline" class="rz-color-on-primary-light rz-display-flex rz-mt-4 rz-mb-0">By, Land</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body1" class="rz-color-on-primary-light"><b>@($"{Listing.City}, {Listing.Country}")</b></RadzenText>
                </RadzenColumn>
                <RadzenColumn SizeSM="8">
                    <RadzenText TextStyle="TextStyle.Overline" class="rz-color-on-primary-light rz-display-flex rz-mt-4 rz-mb-0">Pris pr. dag</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body1" class="rz-color-on-primary-light"><b>@String.Format(new System.Globalization.CultureInfo("da-DK"), "{0:C}", Booking.DailyPrice)</b></RadzenText>
                    <RadzenText TextStyle="TextStyle.Overline" class="rz-color-on-primary-light rz-display-flex rz-mt-4 rz-mb-0">Pris total</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body1" class="rz-color-on-primary-light"><b>@String.Format(new System.Globalization.CultureInfo("da-DK"), "{0:C}", Booking.TotalPrice)</b></RadzenText>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0">
            <RadzenButton Variant="Variant.Text" class="rz-text-secondary-color" Text="Anuller" Click="@Cancel"/>
            <RadzenButton Variant="Variant.Text" Text="Bekræft" Click="@Submit" />
        </RadzenStack>
    </RadzenCard>
}

@code {
    private string? error = null;

    private void Cancel()
    {
        NavigationManager.NavigateTo("/listings");
    }

    async private Task Submit()
    {
        try
        {
            if (User.UserId != null)
            {
                var request = new CreateBookingRequest(
                        User.UserId.Value,
                        Booking.AccomodationId,
                        Listing.Id,
                        Booking.StartDate,
                        Booking.EndDate,
                        Booking.TotalPrice);

                var statusCode = await Service.MakeBookingAsync(request);

                if (statusCode == 200)
                {
                    await Dialog.Alert("Booking oprettet korrekt", "Booking oprettelse");

                    Booking.Clear();
                    Listing.Clear();
                    NavigationManager.NavigateTo("/listings");

                    
                }

            }
        }
        catch (Exception ex)
        {
            await Dialog.Alert(ex.Message);
        }

    }
}
