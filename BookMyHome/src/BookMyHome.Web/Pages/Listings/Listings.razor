@page "/listings"
@inject IListingService ListingService
@inject BookingState BookingState
@inject IFacilityService FacilityService

@if (ListingsList == null)
{
    <RadzenText TextStyle="TextStyle.Body1" Text="Indlæser listing..." />
}
else
{
    <RadzenText TextStyle="TextStyle.H4" Text="Find dit næste ophold" />
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" JustifyContent="JustifyContent.Start" Gap="1rem">
        <ListingDateComponent OnChangeCallback="@OnDateChange" />

        <ListingFilterComponent ListingsList="@ListingsList"
                                Facilities="@Facilities"
                                FilteredListChangedCallback="@OnFilteredListChanged" />
    </RadzenStack>

    <br />
    <RadzenText TextStyle="TextStyle.DisplayH3">Ledige boliger</RadzenText>
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="0">
        @foreach (var listing in FilteredList)
        {
            <ListingCardComponent Listing="@listing"
                                  ButtonNavigationPath="@($"/listing/{listing.ListingId}")"
                                  NavigationButtonText="Se detaljer" />
        }
    </RadzenStack>
}


@code {

    public IReadOnlyList<ListingResponse>? ListingsList { get; set; }
    private IReadOnlyList<ListingResponse> FilteredList = [];
    private IReadOnlyList<FacilityResponse> Facilities = [];


    protected override async Task OnInitializedAsync()
    {
        ListingsList = await ListingService.GetAllAvailiableListingsByPeriod(BookingState.StartDate, BookingState.EndDate);
        Facilities = await FacilityService.GetAllFacilitiesAsync();
    }

    private async Task OnDateChange()
    {
        ListingsList = await ListingService.GetAllAvailiableListingsByPeriod(BookingState.StartDate, BookingState.EndDate);
    }

    private void OnFilteredListChanged(IReadOnlyList<ListingResponse> result)
    {
        FilteredList = result;
    }



    
}
