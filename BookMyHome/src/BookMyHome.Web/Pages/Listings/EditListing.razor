@page "/listing/{Id:Guid}/edit"

@inject IListingService Service
@inject DialogService Dialog

<ListingFormComponent Model="model" SubmitCallback="Update" SubmitText="Ok" AccomodationsTypes="AccomodationTypes"></ListingFormComponent>


@code {
    [Parameter]
    public Guid Id { get; set; }

    private ListingResponse? listing = null;
    private Guid? accomodationId = null;
    private IReadOnlyList<AccomodationTypeResponse> AccomodationTypes = [];

    private ListingInputModel model = new();

    protected override async Task OnInitializedAsync()
    {

        try
        {
            accomodationId = await Service.GetAccomodationIdByListingId(Id);
            listing = await Service.GetListingAsync(accomodationId.Value, Id);
            AccomodationTypes = await Service.GetAllAccomodationTypes();
            model.AccomodationId = accomodationId.Value;
        }
        catch (Exception ex)
        {
            await Dialog.Alert(ex.Message, "Initial error");
        }
    }

    private async Task Update(ListingInputModel model)
    {
        
    }
}
