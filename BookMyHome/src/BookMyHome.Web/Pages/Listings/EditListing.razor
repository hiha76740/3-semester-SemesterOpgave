@page "/listing/{id:guid}/edit"

@inject IListingService Service
@inject IAccomodationService AccomodationService
@inject DialogService Dialog
@inject NavigationManager NavigationManager

<ListingFormComponent Model="model"
                      SubmitCallback="Update"
                      SubmitText="Ok"
                      AccomodationsTypes="AccomodationTypes"
                      CancelNavigationPath="@($"/accomodation/{model.AccomodationId}/listings")"
                      UploadCallback="Upload"
                      FormTitle="Rediger listing"/>


@code {
    [Parameter]
    public Guid Id { get; set; }

    private ListingResponse? listing = null;
    private Guid? accomodationId = null;
    private IReadOnlyList<AccomodationTypeResponse> AccomodationTypes = [];

    private ListingInputModel model = new();

    protected override async Task OnInitializedAsync()
    {

        try
        {
            accomodationId = await Service.GetAccomodationIdByListingId(Id);
            listing = await Service.GetListingAsync(accomodationId.Value, Id);
            AccomodationTypes = await AccomodationService.GetAllAccomodationTypes();

            model.ListingId = listing.ListingId;
            model.AccomodationId = accomodationId.Value;
            model.ListingName = listing.ListingName;
            model.DailyPrice = listing.DailyPrice;
            model.HouseRules = listing.HouseRules;
            model.AccomodationType = listing.AccomodationType;

            model.RowVersion = listing.RowVersion;

            if (listing.Status == "Active")
                model.Status = true;
            else
                model.Status = false;

        }
        catch (Exception ex)
        {
            await Dialog.Alert(ex.Message, "Initial error");
        }
    }

    private async Task Update(ListingInputModel model)
    {
        try
        {
            var status = "";

            if (model.Status == true)
                status = "Active";
            else
                status = "Inactive";

            var request = new UpdateListingRequest(
                model.ListingName,
                model.DailyPrice,
                model.HouseRules,
                model.AccomodationType,
                status,
                model.RowVersion
            );

            var responseCode = await Service.UpdateListing(model.AccomodationId, model.ListingId, request);

            if (responseCode == 200)
            {
                await Dialog.Alert("Listing updated successfully", "Information");
                NavigationManager.NavigateTo($"/accomodation/{model.AccomodationId}/listings");
            }
            else
            {
                await Dialog.Alert($"Error:{responseCode}, Error while updating listing", "Error");
            }
        }
        catch (Exception ex)
        {
            await Dialog.Alert(ex.Message, "Update error");
        }
    }

    private async Task Upload(IBrowserFile? selectedFile)
    {
        try
        {
            if (selectedFile == null)
                return;

            var statusCode = await Service.UploadImageAsync(Id, selectedFile);

            if (statusCode == 200)
            {
                await Dialog.Alert("Billede gemt korrekt", "Information");
                NavigationManager.NavigateTo("/accomodations");
            }
            else
            {
                await Dialog.Alert($"Error code: {statusCode.ToString()}");
            }
        }
        catch (Exception ex)
        {
            await Dialog.Alert(ex.Message, "Upload error");
        }
    }
}
