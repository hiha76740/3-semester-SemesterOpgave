@inherits LayoutComponentBase

<HeadContent>
    <RadzenTheme Theme="material" />
</HeadContent>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <RadzenProfileMenu>
                <Template>
                    <RadzenGravatar Email="user@example.com">
                    </RadzenGravatar>
                </Template>
                <ChildContent>
                    <RadzenProfileMenuItem Text="Login eller registre dig" Path="/login" Icon="lock_open"></RadzenProfileMenuItem>
                    <RadzenProfileMenuItem Text="Profil" Path="/user/profile" Icon="account_circle"></RadzenProfileMenuItem>
                    <RadzenProfileMenuItem Text="Mine bookinger" Path="/bookings" Icon="book"></RadzenProfileMenuItem>
                </ChildContent>
            </RadzenProfileMenu>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
