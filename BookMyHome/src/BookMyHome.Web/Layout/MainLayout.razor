@using System.Net
@inherits LayoutComponentBase
@inject UserState UserState
@inject IAuthService service

<HeadContent>
    <RadzenTheme Theme="material" />
</HeadContent>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @if (UserState.UserId != null)
            {
                <RadzenProfileMenu>
                    <Template>
                        <RadzenGravatar Email="@UserState.Username">
                        </RadzenGravatar>
                    </Template>
                    <ChildContent>
                        <RadzenProfileMenuItem Text="Profil" Path="/user/profile" Icon="account_circle"></RadzenProfileMenuItem>
                        <RadzenProfileMenuItem Text="Mine bookinger" Path="/bookings" Icon="book"></RadzenProfileMenuItem>
                    </ChildContent>
                </RadzenProfileMenu>
            }
            else
            {
                <RadzenProfileMenu>
                    <ChildContent>
                        <RadzenProfileMenuItem Text="Login eller registre dig" Path="/login" Icon="lock_open"></RadzenProfileMenuItem>
                    </ChildContent>
                </RadzenProfileMenu>
            }
        </div>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code{
    private bool userLoaded;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authUser = await service.GetAuthUserAsync();

            UserState.SetUser(
                authUser.Id,
                authUser.Firstname,
                authUser.Lastname,
                authUser.Username,
                authUser.Role
            );

        }
        catch (HttpRequestException ex)
        when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            // do nothing for now
        }
        finally
        {
            userLoaded = true;
        }
    }
}
