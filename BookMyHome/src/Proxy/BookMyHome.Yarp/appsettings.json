{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "YARP": {
    "Routes": {
      "users-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "users-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/users-api"
          }
        ]
      },
      "accomodations-route": {
        "ClusterId": "accomodations-cluster",
        "Match": {
          "Path": "accomodations-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/accomodations-api"
          }
        ]
      },
      "bookings-route": {
        "ClusterId": "bookings-cluster",
        "Match": {
          "Path": "bookings-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/bookings-api"
          }
        ]
      }
    },
    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "users-destination1": {
            "Address": "http://BookMyHome-UserService:8080"
          }
        }
      },
      "accomodations-cluster": {
        "Destinations": {
          "accomodations-destination1": {
            "Address": "http://BookMyHome-AccomodationService:8080"
          }
        }
      },
      "bookings-cluster": {
        "Destinations": {
          "bookings-destination1": {
            "Address": "http://BookMyHome-BookingService:8080"
          }
        }
      }
    }
  }
}
